{
  "name": "stay-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stay MCP server skeleton: read-only R0 tools over public Supabase RPCs",
  "scripts": {
    "typecheck": "tsc --noEmit",
